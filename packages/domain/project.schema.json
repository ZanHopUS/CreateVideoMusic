{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "amvs-project/1",
  "title": "ProjectContent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "timebase",
    "durationTicks",
    "preset",
    "templateRef",
    "orderedTracks",
    "items",
    "lyrics",
    "assetRefs"
  ],
  "properties": {
    "schemaVersion": { "const": "amvs-project/1" },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "timebase": { "const": 48000 },
    "durationTicks": { "type": "integer", "minimum": 1, "maximum": 14400000 },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "enum": [720, 1080, 1280, 1920] },
        "height": { "enum": [720, 1080, 1280, 1920] },
        "fps": { "enum": [30, 60] }
      }
    },
    "templateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "enum": ["TPL-01", "TPL-02", "TPL-03"] },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "orderedTracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/track" }
    },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "lyrics": { "type": "array", "items": { "$ref": "#/$defs/lyric" } },
    "assetRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hash" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tick": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["background", "music", "lyrics", "text"] }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "trackId",
        "type",
        "startTicks",
        "durationTicks",
        "sourceStartTicks",
        "speed",
        "volume"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "trackId": { "$ref": "#/$defs/id" },
        "type": { "enum": ["image", "video", "audio", "text", "lyrics"] },
        "assetId": { "$ref": "#/$defs/hash" },
        "text": { "type": "string", "maxLength": 10000 },
        "lyricId": { "$ref": "#/$defs/id" },
        "role": { "enum": ["song-title", "artist-name"] },
        "startTicks": { "$ref": "#/$defs/tick" },
        "durationTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14400000
        },
        "sourceStartTicks": { "$ref": "#/$defs/tick" },
        "speed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "denominator": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        },
        "volume": { "type": "number", "minimum": 0, "maximum": 2 },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fontFamily": { "enum": ["Arial", "Segoe UI"] },
            "fontSize": { "type": "number", "minimum": 8, "maximum": 300 },
            "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "x": { "type": "number", "minimum": -1920, "maximum": 1920 },
            "y": { "type": "number", "minimum": -1920, "maximum": 1920 },
            "fit": { "enum": ["cover", "contain"] },
            "blur": { "type": "number", "minimum": 0, "maximum": 40 },
            "brightness": { "type": "number", "minimum": 0, "maximum": 2 },
            "cropX": { "type": "number", "minimum": 0, "maximum": 100 },
            "cropY": { "type": "number", "minimum": 0, "maximum": 100 },
            "strokeWidth": { "type": "number", "minimum": 0, "maximum": 10 },
            "strokeColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "shadow": { "type": "boolean" },
            "animation": { "enum": ["none", "fade", "slide", "scale"] },
            "highlightColor": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "enum": ["image", "video", "audio"] } }
          },
          "then": { "required": ["assetId"] }
        },
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": { "required": ["text"] }
        },
        {
          "if": { "properties": { "type": { "const": "lyrics" } } },
          "then": { "required": ["lyricId"] }
        }
      ]
    },
    "lyric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "sourceStartTicks",
        "sourceEndTicks",
        "source",
        "status",
        "alignmentStatus",
        "words"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "maxLength": 10000 },
        "sourceStartTicks": { "$ref": "#/$defs/tick" },
        "sourceEndTicks": { "$ref": "#/$defs/tick" },
        "source": { "enum": ["user", "import", "asr", "aligner"] },
        "status": { "enum": ["draft", "reviewed"] },
        "alignmentStatus": { "enum": ["unknown", "sentence", "word"] },
        "sourceAudioItemId": { "$ref": "#/$defs/id" },
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "startTicks", "endTicks"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 500 },
              "startTicks": { "$ref": "#/$defs/tick" },
              "endTicks": { "$ref": "#/$defs/tick" },
              "rawScore": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
